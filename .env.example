# Copia este ficheiro para .env.local e preenche com os valores reais.
# O .env.local fica fora do Git (.gitignore: *.local). Nunca commites valores reais.
# Em produção, estes valores vêm dos GitHub Secrets (ver .github/workflows/deploy.yml).

# Firebase (config web — pública por design; segurança vem das Firestore Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web3Forms (notificação por email ao admin) — https://web3forms.com
VITE_WEB3FORMS_KEY=
